# Credential-scan allowlist — <rule><TAB><path-glob><TAB><reason>
#
# A reason is mandatory. An entry without one is rejected by the scanner, because
# "why is this allowed" is the only part of the entry that still means anything
# a year from now. Suppressed hits are counted and printed on every run; nothing
# is suppressed silently.
#
# Rule `*` matches any rule. Path globs are matched against the repo-relative
# path (or the archive path, without the ::member suffix).

# --- documented placeholder, not a key -------------------------------------
# The integration docs show `sk-9router-xxxxxxxxxxxx` as the literal example of
# the router's own key format. It is not a value anyone can authenticate with.
openai-key	gitbook/content/*	documented key-format placeholder in integration guides

# --- test fixtures ---------------------------------------------------------
# Mock credentials constructed inside unit tests. `sk-mach01...` is built from
# the machine-id fixture, `sk-secret...3456` is a literal fake in an xai video
# test. Neither reaches a provider; both are asserted against locally.
openai-key	tests/unit/embeddings.cloud.test.js	mock key fixture for cloud-embedding request shaping
openai-key	tests/unit/xai-video-core.test.js	fake key literal in a request-body assertion
bearer-literal	tests/unit/xai-video-core.test.js	same fake literal, quoted inside an error-string assertion

# --- third-party public client key -----------------------------------------
# Windsurf's Firebase Web API key, shipped by them in client-side JS and present
# in every browser session against their app. It authenticates nothing on its
# own (Firebase web keys are public identifiers, protected by security rules).
# It is vendored here because the provider registry needs it to run the OAuth
# chain. Not a leak of any credential belonging to this project.
google-api-key	open-sse/providers/registry/windsurf.js	upstream Windsurf public Firebase web key, required for the OAuth chain

# --- documentation prose ---------------------------------------------------
# `Bearer your-api-key-here` style examples in the guides.
bearer-literal	gitbook/content/*	documentation example, literal placeholder token
